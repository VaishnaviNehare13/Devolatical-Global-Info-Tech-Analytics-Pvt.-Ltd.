# ==========================================
# Backend Production Environment Template
# ==========================================

# Server Environment
PORT=5000
NODE_ENV=production

# Database Connection (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:5432/<dbname>?schema=public
DATABASE_URL="postgresql://postgres:YOUR_SECURE_DB_PASSWORD@postgres:5432/devolatical_db?schema=public"

# CORS Configuration
# Origin allowed to make cross-domain API requests to backend
CORS_ORIGIN="https://yourdomain.com"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Authentication & JWT Config (MUST BE AT LEAST 16 CHARACTERS LONG)
JWT_ACCESS_SECRET="GENERATE_UNIQUE_STRONG_64_CHAR_RANDOM_SECRET_KEY_FOR_ACCESS"
JWT_REFRESH_SECRET="GENERATE_UNIQUE_STRONG_64_CHAR_RANDOM_SECRET_KEY_FOR_REFRESH"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_ISSUER="devolatical-global-api"
JWT_AUDIENCE="devolatical-client-portal"
JWT_ALGORITHM="HS256"

# Password Hashing Security
BCRYPT_SALT_ROUNDS=12

# SMTP Production Mailer Config
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASSWORD="YOUR_PRODUCTION_SMTP_PASSWORD"
SMTP_FROM="noreply@devolatical.com"
