# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"

# Security & CORS Configuration
CORS_ORIGIN="http://localhost:5173"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Authentication Configuration
JWT_ACCESS_SECRET="your_jwt_access_secret_must_be_at_least_16_characters_long"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_must_be_at_least_16_characters_long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_ISSUER="devolatical-global-api"
JWT_AUDIENCE="devolatical-client-portal"
JWT_ALGORITHM="HS256"

# Security Configuration
BCRYPT_SALT_ROUNDS=12

# Email Configuration
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="smtp_user"
SMTP_PASSWORD="smtp_password"
SMTP_FROM="noreply@yourdomain.com"
