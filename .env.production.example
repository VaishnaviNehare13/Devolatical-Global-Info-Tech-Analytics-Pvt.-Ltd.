# ==========================================
# Frontend Production Environment Template
# ==========================================

# API Base URL for Client HTTP Request Client
# When using Nginx Reverse Proxy on the same host/domain, use relative path /api/v1
# If backend is hosted on a separate API domain, specify https://api.yourdomain.com/api/v1
VITE_API_BASE_URL=/api/v1

# Frontend HTTP Port binding (for Docker compose mapping)
HTTP_PORT=80
